# ==========================================
# 1. Application / Runtime Configuration
# ==========================================
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# ==========================================
# 2. PostgreSQL Configuration (Transactional Source of Truth)
# ==========================================
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=commerce_db
DATABASE_USER=postgres
DATABASE_PASSWORD=placeholder_postgres_password
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ==========================================
# 3. Redis Configuration (Restricted to Cache, Rate Limiting & Ephemeral State)
# ==========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=placeholder_redis_password
REDIS_TLS=false

# ==========================================
# 4. Identity / Authentication Configuration
# ==========================================
ACCESS_TOKEN_SECRET=placeholder_at_least_16_char_secret_key_change_in_production
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

# ==========================================
# 4. Observability Configuration
# ==========================================
SERVICE_NAME=commerce-api
LOG_PRETTY=true
REDACT_KEYS=password,token,secret,authorization,creditCard,apiKey

# ==========================================
# 5. Email (Resend) Configuration — optional
# Without RESEND_API_KEY the API logs mail via an in-memory outbox (dev/test).
# Verify a sending domain at https://resend.com/domains, then set EMAIL_FROM
# to an address on it (the default onboarding address only delivers to you).
# ==========================================
# RESEND_API_KEY=re_your_key_here
# EMAIL_FROM=Store <hello@yourdomain.com>
# FRONTEND_URL=http://localhost:3000

# ==========================================
# 6. Meta WhatsApp Business Cloud API — optional
# Set WHATSAPP_PROVIDER=meta with credentials to connect live Meta WhatsApp Business.
# When omitted or set to 'mock', an in-memory test provider is used.
# ==========================================
# WHATSAPP_PROVIDER=meta
# WHATSAPP_ACCESS_TOKEN=EAAB...
# WHATSAPP_PHONE_NUMBER_ID=1000...
# WHATSAPP_APP_SECRET=your_meta_app_secret_here
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_custom_webhook_verify_token
# WHATSAPP_API_VERSION=v20.0

# ==========================================
# 7. Real Payment Gateway (Stripe) Configuration — optional
# Set PAYMENT_PROVIDER=stripe with credentials to connect Stripe test/sandbox gateway.
# When omitted or set to 'mock', the deterministic mock provider is used.
# ==========================================
# PAYMENT_PROVIDER=stripe
# STRIPE_SECRET_KEY=sk_test_51...
# STRIPE_PUBLISHABLE_KEY=pk_test_51...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_WEBHOOK_TOLERANCE_SECONDS=300

# ==========================================
# 8. Real Shipping & Carrier Gateway (Shippo) — optional
# Set CARRIER_PROVIDER=shippo with credentials to connect live Shippo sandbox carrier.
# When omitted or set to 'mock', the deterministic mock carrier provider is used.
# ==========================================
# CARRIER_PROVIDER=shippo
# SHIPPO_API_KEY=shippo_test_...
# SHIPPO_BASE_URL=https://api.goshippo.com
# SHIPPO_WEBHOOK_SECRET=whsec_shippo_test_secret
# SHIPPO_TIMEOUT_MS=10000
# SHIPPO_WEBHOOK_TOLERANCE_SECONDS=300
